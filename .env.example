# Names only. Do not commit real values.

# Postgres connection string. If empty, the app uses an embedded PGLite database.
DATABASE_URL=

# Public address of this app. Parents and students should open this origin.
BETTER_AUTH_URL=

# Session signing secret for Better Auth.
BETTER_AUTH_SECRET=

# xAI API key. Grades an answer, writes the next question, and writes the spelling parent report.
# The owner adds this in the app builder's server settings. The server reads it. It is never logged.
# The call is https://api.x.ai/v1/chat/completions
# Model: grok-4-1-fast-non-reasoning
XAI_API_KEY=

# Gmail SMTP app password. Used to send parent reports.
# SMTP host is smtp.gmail.com, port 465.
# One of these two names is enough.
GMAIL_APP_PASSWORD=
VKOLE_MAIL_SECRET=

# Grok sign-in broker. Injected on a published app.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PREVIEW_CLIENT_SECRET=

# Grok project and connector gate. Used for Gmail connector tools.
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=

# Shared secret for POST /api/vkole/purge on this app only.
# Server only. Do not prefix this name with VITE_. The browser must not see it,
# and account calls must not send it. The website refuses a browser request
# that carries X-Vkole-Secret. Sign-in, register, family, and password reset
# use the bearer token from https://www.dotheimpossible.ai/api/account/*.
VKOLE_SHARED_SECRET=

# Optional. Comma-separated emails that may call the purge while signed in.
# Leave empty to allow the purge only with the shared secret.
VKOLE_ADMIN_EMAILS=

# Optional. Teacher addresses that may open a registrant list in a teacher view.
# That list is never shown on the parent home and is never emailed.
# A parent sign-in, including this address, sees only its own account.
VKOLE_MASTER_EMAIL=

# Set to "false" to turn sign-in off. Leave unset for a normal app.
VITE_AUTH_ENABLED=
VITE_PUBLIC_HOSTNAME=
