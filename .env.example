# Names only. Do not commit real values.

# Postgres connection string. If empty, the app uses an embedded PGLite database.
DATABASE_URL=

# Public address of this app. Parents and students should open this origin.
BETTER_AUTH_URL=

# Session signing secret for Better Auth.
BETTER_AUTH_SECRET=

# xAI API key. Grades an answer and writes the next question.
# The call is https://api.x.ai/v1/chat/completions
# Model: grok-4-1-fast-non-reasoning
XAI_API_KEY=

# Gmail SMTP app password. Used to send parent reports.
# SMTP host is smtp.gmail.com, port 465.
# One of these two names is enough.
GMAIL_APP_PASSWORD=
VKOLE_MAIL_SECRET=

# Grok sign-in broker. Injected on a published app.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PREVIEW_CLIENT_SECRET=

# Grok project and connector gate. Used for Gmail connector tools.
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=

# Shared secret for the school website account API.
# Server only. The browser never sees this value.
# Sent as X-Vkole-Secret to https://www.dotheimpossible.ai/api/vkole/*
# The same header authorizes POST /api/vkole/purge on this app.
VKOLE_SHARED_SECRET=

# Optional. Comma-separated emails that may call the purge while signed in.
# Leave empty to allow the purge only with the shared secret.
VKOLE_ADMIN_EMAILS=

# Set to "false" to turn sign-in off. Leave unset for a normal app.
VITE_AUTH_ENABLED=
VITE_PUBLIC_HOSTNAME=
